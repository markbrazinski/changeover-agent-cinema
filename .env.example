# --- Google Cloud / Gemini / ADK ---
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=your_gemini_api_key_here

# --- Grafana / Prometheus (Local or Grafana Cloud) ---
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token
PROMETHEUS_URL=http://localhost:9090

# --- Grafana Cloud Mimir Remote Write ---
GRAFANA_CLOUD_PROM_USERNAME=123456
GRAFANA_CLOUD_PROM_REMOTE_WRITE_URL=https://prometheus-prod.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_TOKEN=your_remote_write_token_here
