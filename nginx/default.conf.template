server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Security Headers
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; media-src 'self'; connect-src 'none'; frame-ancestors 'none';" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Health check endpoints for Cloud Run & Kubernetes probes
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    location = /readyz {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # Static Media files caching (1 day, immutable)
    location /media/ {
        expires 1d;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; media-src 'self'; connect-src 'none'; frame-ancestors 'none';" always;
    }

    # Vite Hashed JS / CSS Assets (1 year immutable)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; media-src 'self'; connect-src 'none'; frame-ancestors 'none';" always;
    }

    # Single Page Application Fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
